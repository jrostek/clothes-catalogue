{
  "name": "@clothes-catalogue/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "nest:build": "nest build",
    "nest:format": "prettier --write \"src/**/*.ts\"",
    "nest:format:check": "prettier --check \"src/**/*.ts\"",
    "nest:start": "nest start",
    "nest:start:dev": "nest start --watch",
    "nest:start:debug": "nest start --debug --watch",
    "nest:start:prod": "node dist/main",
    "nest:lint": "oxlint --fix src",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "postprisma:migrate:dev": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "start": "npm --prefix ./tools/aspire-apphost run dev",
    "dev": "npm --prefix ./tools/aspire-apphost run dev",
    "build": "npm --prefix ./tools/aspire-apphost run build",
    "format": "npm --prefix ./tools/aspire-apphost run format",
    "lint": "npm --prefix ./tools/aspire-apphost run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk ../../node_modules/jest/bin/jest.js --runInBand",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -b",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clothes-catalogue/dtos": "*",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.68.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-redis": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/instrumentation": "^7.9.1",
    "cache-manager": "^7.2.9",
    "dotenv": "^16.4.7",
    "keyv": "^5.6.0",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/generated/"
    ]
  }
}
